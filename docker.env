# ===========================================
# 钱包管理系统 Docker 环境变量配置
# ===========================================

# 数据库配置
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_PASSWORD=your_secure_wallet_password_here

# Redis配置
REDIS_PASSWORD=your_secure_redis_password_here

# RabbitMQ配置
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here

# 应用配置
APP_ENV=production
APP_DEBUG=false

# 安全配置
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here
ENCRYPT_KEY=your_32_character_encryption_key_here

# 网络配置
APP_PORT=9090
MYSQL_PORT=3307
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 日志级别
LOG_LEVEL=info

# 备份配置
BACKUP_RETENTION_DAYS=30

# ===========================================
# 重要提示：
# 1. 请修改所有默认密码为强密码
# 2. 不要将此文件提交到版本控制系统
# 3. 生产环境请使用外部密钥管理服务
# =========================================== 